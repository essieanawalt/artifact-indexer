# Tool: Claude Code (Claude Opus 5.5)
# Language stack: Python / FastAPI / PostgreSQL 17 / uv
# Prompt Summary: "Harden the PA2 indexer: local RS256 JWT auth, row-level authz, AES-GCM manuscript encryption, input validation, PT1-PT3 mitigations"
# AI Contribution: Placeholder configuration for every variable Compose and the service read (~100%)
# Human Modifications: None yet
# Verification: docker compose --env-file functional-codebase/.env config; Compose test run
# Confidence: High
#
# Copy to .env (git-ignored) and fill in. Placeholders only: never commit real values.
# From PA2/:  docker compose --env-file functional-codebase/.env up --build

# Host path of the PUBLIC JWKS file; mounted read-only into the api container.
JWKS_HOST_PATH=/absolute/path/to/jwks.json
# Path inside the container where the JWKS file is mounted and read.
JWT_JWKS_PATH=/etc/indexer/jwks.json
JWT_ISSUER=http://localhost:9000
JWT_AUDIENCE=cs763-api
# Base64 of exactly 32 random bytes (AES-256-GCM). Generate with:
#   python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes

# Optional limits (PT3). Defaults shown.
MAX_UPLOAD_BYTES=10485760
MAX_JSON_BYTES=1048576
MAX_ZIP_FILES=50
MAX_ZIP_BYTES=104857600
MAX_CONCURRENT_ZIPS=2

# Optional host port for the api service.
PA2_PORT=8002
